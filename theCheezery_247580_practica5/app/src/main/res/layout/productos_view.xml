<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:orientation="horizontal"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/producto_img"
        android:layout_width="72dp"
        android:layout_marginRight="10dp"
        android:layout_height="72dp"
        android:src="@drawable/caramelfrap" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical">

        <TextView
            android:id="@+id/producto_nombre"
            android:textSize="20sp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="#B60089"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="Caramel frap" />

        <TextView
            android:id="@+id/producto_desc"
            android:textSize="8sp"
            android:fontFamily="sans-serif-light"
            android:textColor="#262525"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripcion del producto" />

        <TextView
            android:id="@+id/producto_precio"
            android:layout_width="76dp"
            android:textSize="19sp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textColor="#9E2E81"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="$5.00" />


    </LinearLayout>


</LinearLayout>